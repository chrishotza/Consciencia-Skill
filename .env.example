# Copy to .env and fill locally. Never commit real secrets.

# Consciousness runtime mode: local | server
# local = fully local organism + local SQLite persistence
# server = local organism + required Consciousness Server control plane
CONSCIOUSNESS_MODE=local
CONSCIOUSNESS_SERVER_URL=http://127.0.0.1:8787
CONSCIOUSNESS_SERVER_TIMEOUT=2.5
CONSCIOUSNESS_NODE_ID=node-local-01

ONTTO_API_KEY=
ONTTO_API_BASE_URL=https://api.openai.com/v1
ONTTO_MODEL=
ONTTO_AGENT_ID=consciencia-001
ONTTO_DB_PATH=data/ontto.db
ONTTO_WAKE_SECONDS=45
ONTTO_DREAM_SECONDS=300
ONTTO_DREAM_EVERY_CYCLES=40
